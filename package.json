{
  "name": "calendar",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --parallel --filter @calendar/server --filter @calendar/app dev",
    "dev:server": "pnpm --filter @calendar/server dev",
    "dev:app": "pnpm --filter @calendar/app dev",
    "build": "pnpm --filter @calendar/shared build && pnpm --filter @calendar/server build && pnpm --filter @calendar/app build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm --filter @calendar/shared test && pnpm --filter @calendar/server test",
    "dev:pages": "pnpm --filter @calendar/app dev --mode pages",
    "build:pages": "pnpm --filter @calendar/shared build && pnpm --filter @calendar/app build:pages",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.0",
    "@eslint/js": "^9.12.0",
    "@playwright/test": "^1.65.1",
    "eslint": "^9.12.0",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.8.1"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  }
}
